        "jsonBody": "={\n  \"children\": [\n    {\n      \"object\": \"block\",\n      \"type\": \"heading_2\",\n      \"heading_2\": { \"rich_text\": [{ \"text\": { \"content\": \"{{ $json.report_title }}\" } }] }\n    },\n    {\n      \"object\": \"block\",\n      \"type\": \"paragraph\",\n      \"paragraph\": { \"rich_text\": [{ \"text\": { \"content\": \"Validation status: {{ $json.validation_status }}\" } }] }\n    },\n    {\n      \"object\": \"block\",\n      \"type\": \"paragraph\",\n      \"paragraph\": { \"rich_text\": [{ \"text\": { \"content\": \"{{ $json.summary }}\" } }] }\n    },\n    {\n      \"object\": \"block\",\n      \"type\": \"heading_3\",\n      \"heading_3\": { \"rich_text\": [{ \"text\": { \"content\": \"Key Insights\" } }] }\n    },\n    {\n      \"object\": \"block\",\n      \"type\": \"paragraph\",\n      \"paragraph\": { \"rich_text\": [{ \"text\": { \"content\": \"{{ $json.key_insights }}\" } }] }\n    },\n    {\n      \"object\": \"block\",\n      \"type\": \"heading_3\",\n      \"heading_3\": { \"rich_text\": [{ \"text\": { \"content\": \"Opportunities\" } }] }\n    },\n    {\n      \"object\": \"block\",\n      \"type\": \"paragraph\",\n      \"paragraph\": { \"rich_text\": [{ \"text\": { \"content\": \"{{ $json.opportunities }}\" } }] }\n    },\n    {\n      \"object\": \"block\",\n      \"type\": \"heading_3\",\n      \"heading_3\": { \"rich_text\": [{ \"text\": { \"content\": \"Assumptions Confirmed\" } }] }\n    },\n    {\n      \"object\": \"block\",\n      \"type\": \"paragraph\",\n      \"paragraph\": { \"rich_text\": [{ \"text\": { \"content\": \"{{ $json.assumptions_confirmed }}\" } }] }\n    },\n    {\n      \"object\": \"block\",\n      \"type\": \"heading_3\",\n      \"heading_3\": { \"rich_text\": [{ \"text\": { \"content\": \"Assumptions Challenged\" } }] }\n    },\n    {\n      \"object\": \"block\",\n      \"type\": \"paragraph\",\n      \"paragraph\": { \"rich_text\": [{ \"text\": { \"content\": \"{{ $json.assumptions_challenged }}\" } }] }\n    }\n  ]\n}",
