    {
      "parameters": {
        "jsCode": "const productIdea = $('Product Idea').item.json.markdown;\nconst assumptions = $('Product Assumptions').item.json.markdown;\nconst personas = $('Personas').item.json.markdown;\nconst questions = $('Interview questions').item.json.markdown;\nconst answers = $('Interview answers').item.json.markdown;\n\nconst researchDocument = `\n## Product Idea\n${productIdea}\n\n## Assumptions\n${assumptions}\n\n## Personas\n${personas}\n\n## Interview Questions\n${questions}\n\n## Interview Answers\n${answers}\n`;\n\nconst promptText = `You are a product research synthesis assistant. Given the research document below, determine whether the product idea is validated, partially validated, or not validated by the interview data. Also identify which stated assumptions are confirmed vs challenged by the data.\n\nResearch document:\n${researchDocument}\n\nRespond ONLY with valid JSON in this exact structure, no markdown formatting, no preamble, no code fences:\n{\n  \"validation_status\": \"Validated\" | \"Partially Validated\" | \"Not Validated\",\n  \"summary\": \"string\",\n  \"key_insights\": \"string\",\n  \"opportunities\": \"string\",\n  \"assumptions_confirmed\": \"string\",\n  \"assumptions_challenged\": \"string\"\n}`;\n\nreturn [{ json: {\n  model: \"claude-sonnet-5\",\n  max_tokens: 2000,\n  messages: [{ role: \"user\", content: promptText }]\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "id": "36859c9b-8c7f-476c-b657-4793f3fe80ee",
      "name": "Merge the 5 markdown outputs into one document"
    },
